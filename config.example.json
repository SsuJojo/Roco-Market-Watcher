{
  "server": {
    "_comment": "FastAPI 监听地址和端口。",
    "host": "127.0.0.1",
    "port": 8000
  },
  "polling": {
    "_comment": "轮询间隔，单位秒。",
    "interval_seconds": 60
  },
  "llm": {
    "_comment": "如需接 LLM，传入的将是去掉 HTML 标签后的正文纯文本。",
    "base_url": "https://api.example.com/v1",
    "api_key": "replace-me",
    "model": "replace-with-your-model"
  },
  "fetch": {
    "_comment": "目标网页抓取配置。",
    "sources": [
      {
        "url": "https://example.com/news",
        "class": "article-body"
      }
    ],
    "headers": {
      "_comment": "抓取网页时附带的请求头。",
      "User-Agent": "Mozilla/5.0"
    }
  },
  "listen": [
    "keyword-to-watch"
  ],
  "notify": {
    "_comment": "规则命中后执行的通知命令。",
    "enabled": false,
    "command": "echo \"Matched monitor rule: {{message_file}}\""
  }
}
